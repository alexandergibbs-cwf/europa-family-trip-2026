{
  "name": "europa-family-trip-2026",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/cal/*"]
  },
  "kv_namespaces": [
    { "binding": "SHARED", "id": "ba28e49537184d4a884f43bda85edd5f" }
  ]
}
